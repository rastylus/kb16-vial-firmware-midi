#include QMK_KEYBOARD_H

// KB16 rev1 defines a 4x5 matrix (20 positions).
// Many units are physically 4x4 keys + extra inputs on the 5th column (often encoder switches).
// If some of these don't exist on your hardware, they'll simply do nothing.

const uint16_t PROGMEM keymaps[][MATRIX_ROWS][MATRIX_COLS] = {
    [0] = {
        // col:   0      1      2      3      4
        /* r0 */ { KC_1,  KC_2,  KC_3,  KC_4,  KC_MUTE },
        /* r1 */ { KC_5,  KC_6,  KC_7,  KC_8,  KC_VOLD },
        /* r2 */ { KC_9,  KC_0,  KC_MINS,KC_EQL,KC_VOLU },
        /* r3 */ { KC_ESC,KC_TAB,KC_SPC, KC_ENT,KC_NO   }
    }
};

